<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/detail_bg">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Carte principale d'informations -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/det_item_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/det_item_cat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/det_item_startdate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_body"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/det_item_startHour"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_body"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/det_item_cost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/cost_text_detail"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginVertical="12dp" />

                        <TextView
                            android:id="@+id/det_item_place"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_body" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bouton HelloAsso principal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHelloAsso"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="S'inscrire / Payer via HelloAsso"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red_logo"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    android:layout_marginBottom="24dp" />

                <!-- Actions secondaires (Itinéraire & Calendrier) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fabDirection"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Itinéraire"
                        android:textColor="@color/button_secondary_text"
                        android:backgroundTint="@color/button_secondary_bg"
                        app:strokeColor="@color/button_secondary_stroke"
                        app:strokeWidth="1dp"
                        app:iconTint="@color/button_secondary_text"
                        app:icon="@android:drawable/ic_menu_directions" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fabCalendar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Calendrier"
                        android:textColor="@color/button_secondary_text"
                        android:backgroundTint="@color/button_secondary_bg"
                        app:strokeColor="@color/button_secondary_stroke"
                        app:strokeWidth="1dp"
                        app:iconTint="@color/button_secondary_text"
                        app:icon="@android:drawable/ic_menu_my_calendar" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bouton Favoris flottant -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_baseline_favorite_border_24"
            app:backgroundTint="@color/red_logo"
            app:tint="@color/white"
            app:elevation="4dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>